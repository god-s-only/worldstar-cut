<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_launcher_foreground_animated_base">

    <!-- Scissors pivot circle: spin forever -->
    <target android:name="pivotCircle">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1200"
                android:repeatCount="infinite"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- Play triangle: pulse scale -->
    <target android:name="playTriangle">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="800"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.25"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="800"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.25"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Scissors blade top-left: snip back and forth -->
    <target android:name="bladeTop">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="600"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:propertyName="rotation"
                android:valueFrom="-8"
                android:valueTo="8"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- Scissors blade bottom-right: opposite snip -->
    <target android:name="bladeBottom">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="600"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:propertyName="rotation"
                android:valueFrom="8"
                android:valueTo="-8"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- Dot 1: orbit + pulse -->
    <target android:name="dot1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="1500"
                    android:repeatCount="infinite"
                    android:propertyName="translationX"
                    android:valueType="floatType">
                    <aapt:attr name="android:animation">
                        <set>
                            <objectAnimator
                                android:duration="1500"
                                android:repeatCount="infinite"
                                android:propertyName="translationX"
                                android:valueFrom="0"
                                android:valueTo="6"
                                android:valueType="floatType" />
                        </set>
                    </aapt:attr>
                </objectAnimator>
                <objectAnimator
                    android:duration="1500"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="2.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="1500"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="2.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Dot 2: fade + orbit -->
    <target android:name="dot2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="1200"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.3"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="1200"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.8"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="1200"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.8"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Dot 3: rapid pulse -->
    <target android:name="dot3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="1000"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="2.5"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="1000"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="2.5"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="1000"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0.4"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Dot 4: counter-pulse -->
    <target android:name="dot4">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.8"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.8"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="900"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:propertyName="alpha"
                    android:valueFrom="0.6"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
